{
  "name": "web-maga",
  "version": "1.0.0",
  "private": true,
  "description": "REST API для управления библиотечным фондом",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db": "node --env-file-if-exists=.env src/db/run-migrations.js",
    "db:migrate": "npm run db",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
